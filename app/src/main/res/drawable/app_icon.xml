<?xml version="1.0" encoding="utf-8"?>
<!-- Shape-only launcher icon: framework vector drawables do not work on API 19. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#07080B" />
            <corners android:radius="20dp" />
            <size
                android:width="108dp"
                android:height="108dp" />
        </shape>
    </item>
    <item
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp"
        android:top="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#101117" />
            <stroke
                android:width="2dp"
                android:color="#D4AF37" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:bottom="28dp"
        android:left="28dp"
        android:right="28dp"
        android:top="28dp">
        <shape android:shape="oval">
            <solid android:color="#171820" />
            <stroke
                android:width="2dp"
                android:color="#F0C75E" />
        </shape>
    </item>
    <item
        android:bottom="44dp"
        android:left="44dp"
        android:right="44dp"
        android:top="44dp">
        <shape android:shape="oval">
            <solid android:color="#D4AF37" />
        </shape>
    </item>
    <item
        android:bottom="51dp"
        android:left="51dp"
        android:right="51dp"
        android:top="51dp">
        <shape android:shape="oval">
            <solid android:color="#07080B" />
        </shape>
    </item>
</layer-list>
