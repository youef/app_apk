<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#06070A">
<title>العز | استوديو الإدارة</title>
<link rel="icon" type="image/svg+xml" href="../web/assets/logo.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="admin.css?v=quick-movies-20261101">
<link rel="stylesheet" href="member-ui.css?v=1">
<link rel="stylesheet" href="glass.css?v=glass-studio-v19-20261107">
<link rel="stylesheet" href="glass.css?v=glass-v19-20261107">
</head>
<body>

<div class="ambient" aria-hidden="true">
  <span class="ambient-glow ambient-glow--gold"></span>
  <span class="ambient-glow ambient-glow--crimson"></span>
  <span class="ambient-grain"></span>
</div>

<!-- ============================ login ============================ -->
<section class="login" id="loginScreen" aria-labelledby="loginTitle">
  <div class="login-card">
    <div class="login-brand">
      <img src="../web/assets/logo.svg" alt="شعار العز TV" width="66" height="66">
      <div>
        <strong>العز <span>TV</span></strong>
        <small>AL EZZ STUDIO</small>
      </div>
    </div>

    <h1 id="loginTitle">الدخول إلى استوديو العز</h1>
    <p class="login-sub">لوحة إدارة المحتوى — للمسؤولين المعتمدين فقط.</p>

    <form id="loginForm" novalidate>
      <div class="field">
        <label for="loginEmail">البريد الإلكتروني</label>
        <input id="loginEmail" type="email" autocomplete="username" dir="ltr" placeholder="admin@example.com" required>
      </div>
      <div class="field">
        <label for="loginPassword">كلمة المرور</label>
        <div class="password-wrap">
          <input id="loginPassword" type="password" autocomplete="current-password" dir="ltr" required>
          <button class="pw-toggle" id="togglePassword" type="button" aria-label="إظهار كلمة المرور" aria-pressed="false">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>
      <p class="form-error" id="loginError" role="alert" hidden></p>
      <button class="btn btn-gold btn-block" id="loginSubmit" type="submit">
        <span class="btn-label">تسجيل الدخول</span>
      </button>
    </form>

    <p class="login-hint">
      تُنشأ الحسابات من Supabase Auth، وتُمنح صلاحية الإدارة عبر جدول <code>aseel_admins</code>.
      لا تُخزَّن كلمة المرور في المتصفح أو في المستودع.
    </p>
    <p class="login-foot">العز TV — جميع الحقوق محفوظة</p>
  </div>
</section>

<!-- ============================ app shell ============================ -->
<div class="app" id="appScreen" hidden>

  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <img src="../web/assets/logo.svg" alt="شعار العز TV" width="42" height="42">
      <div class="brand-copy">
        <strong>العز <span>TV</span></strong>
        <small>AL EZZ STUDIO</small>
      </div>
    </div>
    <nav class="nav" id="nav" aria-label="أقسام الإدارة"></nav>
    <a class="nav-item" href="/studio/#smart-sync" target="_blank" rel="noopener noreferrer"><span class="nav-icon" aria-hidden="true">⟳</span><span>المزامنة الذكية</span></a>
    <div class="sidebar-foot">
      <span class="live-dot" aria-hidden="true"></span>
      <span>متصل بقاعدة بيانات Supabase</span>
    </div>
  </aside>

  <div class="main">
    <header class="topbar">
      <div class="topbar-title">
        <h1 id="pageTitle">لوحة التحكم</h1>
        <p id="pageCrumb">نظرة عامة</p>
      </div>

      <div class="topbar-tools">
        <a class="btn btn-gold btn-sm" href="/account/customers">حسابات العملاء</a>
        <a class="btn btn-gold btn-sm" href="/studio/sources">مراجعة مصادر المسلسلات</a>
        <form method="post" action="/account/logout"><button class="btn btn-ghost btn-sm">خروج الموقع</button></form>
        <label class="topbar-search">
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
          <input id="globalSearch" type="search" placeholder="بحث سريع في القسم الحالي…" aria-label="بحث سريع">
        </label>
        <a class="btn btn-gold btn-sm" href="series-quick.html">⚡ إضافة مسلسل وحلقاته</a>
        <a class="btn btn-gold btn-sm" href="bulk-import.html" target="_blank" rel="noopener noreferrer">الاستيراد الجماعي الذكي</a>
        <a class="btn btn-ghost btn-sm" href="/studio/#smart-sync" target="_blank" rel="noopener noreferrer">⟳ المزامنة الذكية</a>
        <a class="btn btn-ghost btn-sm hide-sm" href="import-studio.html" target="_blank" rel="noopener noreferrer">استيراد الأفلام المتقدم</a>
        <a class="btn btn-ghost btn-sm hide-sm" href="../web/index.html" target="_blank" rel="noopener noreferrer">
          عرض الموقع
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M19 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4"/></svg>
        </a>
        <div class="account">
          <span class="account-email" id="accountEmail" dir="ltr"></span>
          <button class="icon-btn" id="logoutBtn" type="button" aria-label="تسجيل الخروج" title="تسجيل الخروج">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>
          </button>
        </div>
      </div>
    </header>

    <div class="banner" id="adminWarning" role="status" hidden>
      <svg class="banner-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
      <p id="adminWarningText"></p>
      <button class="banner-close" id="bannerClose" type="button" aria-label="إغلاق التنبيه">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <main class="content" id="view" tabindex="-1"></main>
  </div>
</div>

<!-- ============================ slide-over drawer ============================ -->
<div class="scrim" id="drawerScrim" hidden></div>
<aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawerTitle" hidden>
  <header class="drawer-head">
    <div>
      <p class="eyebrow" id="drawerKicker">CONTENT</p>
      <h2 id="drawerTitle">إضافة</h2>
    </div>
    <button class="icon-btn" id="drawerClose" type="button" aria-label="إغلاق النموذج">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </header>

  <div class="drawer-body">
    <div class="drawer-preview" id="drawerPreview">
      <div class="preview-poster" id="previewPoster">
        <img id="previewImage" alt="" hidden>
        <span aria-hidden="true">EZ</span>
      </div>
      <div class="preview-copy">
        <strong id="previewTitle">—</strong>
        <small id="previewSub">أدخل بيانات العمل لمعاينة البطاقة</small>
        <div class="preview-tags">
          <span class="pill pill--published" id="previewStatus">منشور</span>
          <span class="chip" id="previewQuality" hidden>HD</span>
        </div>
      </div>
    </div>

    <p class="form-error" id="drawerError" role="alert" hidden></p>
    <form id="drawerForm" novalidate></form>
  </div>

  <footer class="drawer-foot">
    <div class="drawer-foot-actions">
      <button class="btn btn-gold" id="drawerSave" type="submit" form="drawerForm">
        <span class="btn-label">حفظ</span>
      </button>
      <button class="btn btn-ghost" id="drawerCancel" type="button">إلغاء</button>
    </div>
    <p class="drawer-note">يُحفظ السجل مباشرة في قاعدة البيانات.</p>
  </footer>
</aside>

<!-- ============================ delete modal ============================ -->
<div class="modal-scrim" id="modalScrim" hidden></div>
<div class="modal" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="deleteTitle" hidden>
  <h2 id="deleteTitle">تأكيد الحذف</h2>
  <p class="modal-text" id="deleteText"></p>
  <div class="field">
    <label id="deleteConfirmLabel" for="deleteConfirmInput">اكتب «حذف» للتأكيد</label>
    <input id="deleteConfirmInput" type="text" autocomplete="off" placeholder="حذف">
  </div>
  <p class="form-error" id="deleteError" role="alert" hidden></p>
  <div class="modal-actions">
    <button class="btn btn-danger" id="deleteConfirmBtn" type="button" disabled>حذف نهائي</button>
    <button class="btn btn-ghost" id="deleteCancelBtn" type="button">إلغاء</button>
  </div>
</div>

<div class="toasts" id="toasts" role="status" aria-live="polite"></div>

<script src="config.js?v=quick-movies-20261101"></script>
<script src="admin.js?v=health-cors-20261105-v1"></script>
</body>
</html>
